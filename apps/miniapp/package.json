    "build:mp-weixin:dev": "node scripts/clean-mp-weixin-output.mjs && uni build -p mp-weixin --mode wechat-development && node scripts/write-mp-weixin-compat-modules.mjs && node scripts/verify-mp-weixin-output.mjs",
    "test:frontend-contracts": "node scripts/assert-development-api-contracts.mjs",
    "test:formal-runtime-contracts": "node --experimental-strip-types scripts/assert-formal-runtime-contracts.mjs",
    "preflight:p021-visual": "node scripts/preflight-p021-visual-evidence.mjs --preflight"
    ,"test:p021-it-collector": "node scripts/test-p021-it-page-collector.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5020320260731001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5020320260731001",
    "@dcloudio/uni-components": "3.0.0-alpha-5020320260731001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5020320260731001",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5020320260731001",
    "typescript": "5.4.5",
    "vite": "5.2.8"
  }
