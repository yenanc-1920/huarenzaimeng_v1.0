  "dependencies": {
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "typescript": "5.9.3",
    "vite": "8.2.0",
    "vue-tsc": "3.3.9"
  }
}
